@model CadastrarCursoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Curso";
}

<h5>Cadastro de Curso</h5>

<hr />

<form asp-action="Cadastrar" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>

        <input asp-for="Nome"
               class="form-control" />

        <span asp-validation-for="Nome"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoria</label>

        <select asp-for="CategoriaId"
                asp-items="ViewBag.Categorias"
                class="form-select">

            <option value="">Selecione uma categoria</option>
        </select>

        <span asp-validation-for="CategoriaId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Nivel" class="form-label">Nível</label>

        <select asp-for="Nivel"
                class="form-select">

            <option value="0">Selecione um nível</option>
            <option value="1">Básico</option>
            <option value="2">Intermediário</option>
            <option value="3">Avançado</option>
        </select>

        <span asp-validation-for="Nivel"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="CargaHoraria" class="form-label">
            Carga Horária
        </label>

        <input asp-for="CargaHoraria"
               type="number"
               min="1"
               class="form-control" />

        <span asp-validation-for="CargaHoraria"
              class="text-danger">
        </span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-primary rounded-pill px-4">
            Gravar
        </button>

        <a asp-action="Listar"
           class="btn btn-outline-primary rounded-pill px-4">
            Voltar
        </a>
    </div>
</form>