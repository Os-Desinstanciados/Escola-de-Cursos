@model ExcluirCursoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Curso";
}

<hr />

<div class="alert alert-warning" role="alert">
    Deseja realmente excluir este curso?
</div>

<div class="mb-3">
    <p>
        <strong>Nome:</strong> @Model.Nome
    </p>

    <p>
        <strong>Categoria:</strong> @Model.Categoria
    </p>

    <p>
        <strong>Nível:</strong> @Model.Nivel
    </p>

    <p>
        <strong>Carga Horária:</strong> @Model.CargaHoraria h
    </p>
</div>

<form asp-action="Excluir" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="d-flex gap-2">
        <a asp-action="Listar"
           class="btn btn-outline-primary rounded-pill px-4">
            Voltar
        </a>

        <button type="submit"
                class="btn btn-danger rounded-pill px-4">
            Confirmar
        </button>
    </div>
</form>