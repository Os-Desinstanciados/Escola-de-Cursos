@model List<EscolaDeCursos.Dominio.Modulos.ModuloCategoria.Categoria>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Visualização de Categoria";
}

<a class="btn btn-outline-primary rounded-pill px-4 mb-3"
   asp-controller="Categoria"
   asp-action="Cadastrar">
    Cadastrar Novo
</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3"
         role="alert">
        Nenhuma categoria cadastrada.
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Id</td>
                    <td>@categoria.Nome</td>

                    <td class="text-end">
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3"
                           asp-action="Editar"
                           asp-route-id="@categoria.Id">
                            Editar
                        </a>

                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3"
                           asp-action="Excluir"
                           asp-route-id="@categoria.Id">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}