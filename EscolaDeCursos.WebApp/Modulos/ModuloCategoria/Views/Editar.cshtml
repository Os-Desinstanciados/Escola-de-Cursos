@model EditarCategoriaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Categoria";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-5">

                <form asp-controller="Categoria"
                      asp-action="Editar"
                      method="post">

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-5">
                        <label asp-for="Nome" class="form-label">
                            Nome:
                        </label>

                        <input asp-for="Nome"
                               class="form-control" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-end gap-3">                        
                        <a asp-action="Listar" class="btn btn-outline-primary rounded-pill px-4">
                            Voltar
                        </a>

                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            Editar
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>