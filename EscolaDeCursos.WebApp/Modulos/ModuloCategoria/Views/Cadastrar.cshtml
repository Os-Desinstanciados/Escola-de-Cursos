@model CadastrarCategoriaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Categorias";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="mb-4">Cadastro de Categorias</h2>

        <div class="card shadow-sm">
            <div class="card-body p-5">

                <form asp-controller="Categoria"
                      asp-action="Cadastrar"
                      method="post">

                    <div class="mb-5">
                        <label asp-for="Nome" class="form-label">
                            Nome:
                        </label>

                        <input asp-for="Nome"
                               class="form-control" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-end gap-3">
                        <a class="btn btn-outline-secondary"
                           asp-controller="Categoria"
                           asp-action="Listar">
                            Voltar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Salvar
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>