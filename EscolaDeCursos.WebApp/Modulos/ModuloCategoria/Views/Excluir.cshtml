@model ExcluirCategoriaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Categoria";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="mb-4">Exclusão de Categoria</h2>

        <div class="card shadow-sm">
            <div class="card-body p-5">

                <p>Deseja realmente excluir a categoria <strong>@Model.Nome</strong>?</p>

                <form asp-controller="Categoria" asp-action="Excluir" method="post">

                    <input asp-for="Id" type="hidden" />

                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Listar" class="btn btn-outline-primary rounded-pill px-4">
                            Voltar
                        </a>

                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            Confirmar
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>